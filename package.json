{
  "name": "lorvath-fleet",
  "version": "0.1.0",
  "description": "Painel multi-conta para Lorvath (MU Idle) - grid de janelas do jogo + MCP por conta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/selfcheck.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.andrevinicius.lovarthfleet",
    "productName": "Lovarth Fleet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist${/*}",
      "!test${/*}",
      "!data${/*}",
      "!*.tar.gz"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "LovarthFleet-${version}-portable.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LovarthFleet-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "game-probe.js"
    ]
  }
}